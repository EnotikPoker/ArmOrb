/* ArmOrb v0.9 — graphite interface, light simulation arena. */
.app { flex-grow: 1; background-color: #11151e; color: #eef2fa; padding: 12px 20px 10px; }
Label { white-space: normal; color: #eef2fa; }
Button { min-height: 80px; border-width: 1px; border-color: #353f52; border-radius: 12px; margin: 0; padding: 10px 16px; color: #eef2fa; background-color: #202836; font-size: 23px; }
Button:hover { background-color: #2b3648; }
Button:active { background-color: #374864; }
Button:disabled { background-color: #191f2b; color: #778399; border-color: #2a3241; }
Button.selected { border-width: 2px; border-color: #6ba5ff; background-color: #263c5c; }
.row { flex-direction: row; align-items: center; justify-content: space-between; }
.header { height: 96px; flex-shrink: 0; margin-bottom: 8px; }
.logo { font-size: 44px; -unity-font-style: bold; letter-spacing: 3px; }
.page-title { font-size: 28px; -unity-font-style: bold; }
.version { font-size: 19px; color: #8e9db5; }
.vector-icon { width: 52px; height: 52px; flex-shrink: 0; }
.icon-button { min-width: 96px; min-height: 96px; flex-direction: row; align-items: center; justify-content: center; padding: 10px; border-color: #2e384a; }
.icon-button .vector-icon { width: 38px; height: 38px; }
.icon-button-label { font-size: 22px; margin-left: 6px; }
.setup-scroll { flex-grow: 1; }
.home-content { padding: 6px 0 22px; }
.main-content { padding: 16px 0; }
.mode-hero { height: 420px; align-items: flex-start; justify-content: flex-end; padding: 28px; background-color: #213650; border-color: #4b75a5; margin-bottom: 18px; overflow: hidden; }
.hero-art { position: absolute; left: 0; right: 0; top: 0; height: 265px; }
.hero-orb { position: absolute; width: 112px; height: 112px; border-radius: 60px; border-width: 4px; border-color: #c8dafa; }
.hero-orb-0 { left: 80px; top: 65px; }
.hero-orb-1 { left: 335px; top: 35px; }
.hero-orb-2 { left: 235px; top: 145px; width: 85px; height: 85px; }
.hero-weapon { position: absolute; width: 120px; height: 100px; left: 70px; top: 5px; }
.hero-title { font-size: 38px; -unity-font-style: bold; margin-bottom: 10px; }
.hero-caption { font-size: 22px; color: #b4cae8; }
.hero-go { position: absolute; right: 22px; bottom: 26px; width: 54px; height: 54px; }
.menu-mode-card { flex-direction: row; align-items: center; height: 142px; padding: 20px; margin-bottom: 16px; }
.menu-mode-body { flex-grow: 1; margin-left: 20px; }
.menu-mode-card > .mode-arrow { width: 25px; height: 25px; }
.card-title { font-size: 27px; -unity-font-style: bold; margin-bottom: 5px; }
.continue-card { flex-direction: row; align-items: center; min-height: 112px; margin-bottom: 18px; background-color: #1f3d38; border-color: #4b9d83; }
.continue-body { margin-left: 16px; }
.continue-bet { margin-bottom: 18px; background-color: #393122; border-color: #947b43; }
.footer { min-height: 70px; flex-shrink: 0; }
.text-button { border-width: 0; color: #b0bdd2; background-color: rgba(0,0,0,0); font-size: 21px; }
.section-name { font-size: 28px; -unity-font-style: bold; margin-top: 20px; margin-bottom: 14px; }
.small { font-size: 20px; }
.muted { color: #99a8bf; }
.rule { font-size: 23px; margin-bottom: 18px; }
.error { color: #ff9299; font-size: 22px; margin: 12px 0; }
.primary { min-height: 92px; margin-top: 20px; font-size: 28px; -unity-font-style: bold; background-color: #366fea; border-color: #679cff; color: white; flex-shrink: 0; }
.primary:hover { background-color: #477ff0; }
.secondary { min-height: 80px; margin-top: 12px; }
.conditions, .test-card, .setup-options, .weapon-info { padding: 18px; margin-bottom: 14px; border-width: 1px; border-color: #303b4f; border-radius: 12px; background-color: #1b2331; }
.condition-title { font-size: 25px; -unity-font-style: bold; margin-bottom: 8px; }
.condition-line { font-size: 20px; color: #a7b6cc; margin: 12px 0 0; }
.setup-note { margin-top: 16px; margin-bottom: 12px; }
.balance { font-size: 25px; -unity-font-style: bold; color: #ffd58a; }
.coin-balance { justify-content: flex-start; margin: 6px 0 16px; }
.coin-balance .vector-icon { width: 38px; height: 38px; margin-right: 12px; }
.weapon-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.weapon-tile { width: 19%; min-height: 112px; align-items: center; justify-content: center; padding: 8px 4px; margin-bottom: 9px; }
.weapon-tile-image { width: 70px; height: 59px; margin-bottom: 6px; }
.weapon-tile-name { font-size: 17px; -unity-text-align: middle-center; }
.weapon-info { margin-top: 4px; }
.weapon-base-stats { color: #8db8ff; font-size: 23px; margin-bottom: 8px; }
.ability-options { align-items: stretch; margin-bottom: 18px; }
.ability-option { width: 49%; align-items: flex-start; padding: 18px; min-height: 195px; }
.ability-option .vector-icon { margin-bottom: 10px; }
.bot-controls { margin-top: 14px; }
.count-control { margin-bottom: 14px; }
.setting-label { font-size: 23px; margin-top: 16px; margin-bottom: 12px; }
.count-control .setting-label { flex-grow: 1; margin: 0; }
.count-button { min-width: 80px; margin: 0 10px; font-size: 28px; }
.timer { font-size: 28px; -unity-font-style: bold; }
.preview-fighters { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.preview-fighter { width: 49%; flex-direction: row; align-items: center; background-color: #202836; border-left-width: 4px; padding: 10px; margin-bottom: 8px; border-radius: 6px; }
.preview-weapon { width: 45px; height: 45px; margin-right: 10px; }
.preview-name { font-size: 21px; }
.wide-field { min-height: 72px; font-size: 23px; margin-bottom: 12px; }
.unity-base-field__label { color: #b9c6dc; }
.wide-field .unity-base-field__input, .weapon-dropdown .unity-base-field__input, .compact-hp .unity-base-field__input, .stake-input .unity-base-field__input { color: #eef2fa; background-color: #2b3547; border-width: 1px; border-color: #45526b; border-radius: 8px; padding: 12px; }
.unity-base-popup-field__text { color: #eef2fa; }
.unity-base-popup-field__arrow { -unity-background-image-tint-color: #c9d6ed; }
.unity-base-text-field__input { color: #eef2fa; }
.unity-base-text-field__input > .unity-text-element { color: #eef2fa; }
.unity-base-popup-field__menu { background-color: #263144; }
.unity-scroll-view__vertical-scroller { width: 10px; }
.option-toggle { min-height: 70px; font-size: 22px; margin-top: 12px; }
.option-toggle .unity-toggle__checkmark { width: 30px; height: 30px; margin-right: 12px; }
.test-card { border-left-width: 4px; }
.test-weapon-image { width: 48px; height: 48px; margin-right: 8px; }
.participant-number { width: 35px; font-size: 22px; }
.weapon-dropdown { flex-grow: 1; min-height: 72px; font-size: 22px; margin-right: 12px; }
.compact-hp { width: 155px; min-height: 72px; font-size: 22px; }
.compact-hp > .unity-base-field__label { width: 30px; min-width: 30px; }
.test-card > .small { margin-top: 12px; }
.bet-choice { min-height: 94px; border-left-width: 5px; padding: 12px; margin-top: 10px; }
.bet-choice.selected { border-color: #79aaff; background-color: #263c5c; }
.offer-icon { width: 48px; height: 45px; margin-right: 12px; }
.offer-name { flex-grow: 1; font-size: 23px; }
.offer-health { width: 92px; font-size: 21px; -unity-text-align: middle-right; }
.offer-odds { width: 106px; font-size: 28px; -unity-font-style: bold; -unity-text-align: middle-right; color: #ffd58a; }
.stake-input { min-height: 76px; font-size: 25px; margin-top: 20px; }
.stake-input > .unity-base-field__label { min-width: 105px; }
.stake-buttons { margin-top: 10px; }
.stake-button { width: 23%; }
.payout { font-size: 23px; color: #86dcb9; margin: 14px 0; }
.offer-actions > Button { width: 49%; font-size: 23px; }
.calculation { font-size: 23px; color: #8fb8ff; margin: 14px 0 8px; }
.segments { flex-shrink: 0; }
.segment { width: 32%; min-height: 72px; }
.segment.selected { color: white; background-color: #366fea; border-color: #75a5ff; }
/* Combat */
.fight-participants { flex-direction: row; flex-wrap: wrap; justify-content: space-between; flex-shrink: 0; margin-bottom: 5px; }
.fight-participant { width: 49.4%; min-height: 0; height: 64px; padding: 4px 9px; border-width: 0; border-left-width: 4px; border-radius: 7px; margin-bottom: 5px; background-color: #202836; }
.focus-participant { border-top-width: 2px; border-top-color: #75a5ff; background-color: #243751; }
.participant-info { justify-content: flex-start; flex-grow: 1; }
.participant-weapon { width: 34px; height: 34px; margin-right: 8px; }
.participant-body { flex-grow: 1; }
.fighter-label { font-size: 17px; color: #c3cfe3; }
.fight-hp { font-size: 19px; -unity-font-style: bold; }
.health-track { height: 3px; background-color: #3a4456; margin-top: 2px; }
.health-fill { height: 3px; }
.barrier-track { height: 2px; margin-top: 1px; }
.barrier-fill { height: 2px; background-color: #78bcff; }
.reload-track { height: 2px; margin-top: 2px; background-color: #323d50; }
.reload-fill { height: 2px; }
.arena-holder { flex-grow: 1; min-height: 100px; align-items: center; justify-content: center; overflow: hidden; margin-bottom: 5px; }
.arena { flex-shrink: 0; border-radius: 8px; }
.bot-arena-holder { flex-grow: 0; flex-shrink: 0; }
.own-weapon-panel { height: 70px; flex-shrink: 0; padding: 7px 12px; border-radius: 9px; background-color: #202b3e; border-left-width: 3px; border-left-color: #79aaff; }
.own-weapon-image { width: 44px; height: 44px; margin-right: 14px; }
.own-weapon-body { flex-grow: 1; }
.own-weapon-title { font-size: 18px; color: #a8b9d5; margin-bottom: 2px; }
.own-weapon-stats { font-size: 22px; -unity-font-style: bold; }
.stat-increased { border-left-color: #71e6b1; background-color: #244338; }
.build-status { font-size: 18px; min-height: 26px; flex-shrink: 0; margin-top: 4px; color: #9eb1d2; }
.skill-notice { min-height: 23px; font-size: 18px; flex-shrink: 0; color: #a4c0ed; }
.build-panel { height: 366px; min-height: 366px; flex-shrink: 0; flex-grow: 0; padding: 10px; border-radius: 10px; background-color: #192130; border-width: 1px; border-color: #303d53; }
.choice-area, .build-area, .inspection-area { flex-grow: 1; }
.choice-heading { height: 30px; flex-shrink: 0; }
.choice-countdown { font-size: 23px; -unity-font-style: bold; }
.choice-track { height: 4px; background-color: #35415a; margin-top: 5px; margin-bottom: 8px; flex-shrink: 0; }
.choice-progress { height: 4px; background-color: #79aaff; }
.choice-row { flex-grow: 1; flex-direction: column; justify-content: space-between; }
.skill-card { width: 100%; min-height: 96px; height: 96px; flex-direction: row; align-items: center; padding: 8px 10px; background-color: #242e40; border-color: #3b4860; border-radius: 9px; flex-shrink: 0; }
.skill-card.auto-skill { border-color: #7aaaff; border-width: 2px; background-color: #283b57; }
.skill-art { width: 58px; height: 58px; border-radius: 10px; background-color: #192231; align-items: center; justify-content: center; margin-right: 12px; flex-shrink: 0; }
.skill-art .vector-icon { width: 48px; height: 48px; }
.skill-content { flex-grow: 1; flex-shrink: 1; }
.skill-top { justify-content: flex-start; }
.skill-title { font-size: 24px; -unity-font-style: bold; margin-bottom: 3px; }
.skill-level { font-size: 17px; color: #a8c7f4; margin-left: 12px; }
.skill-description { font-size: 20px; color: #d1dced; }
.skill-auto { width: 48px; font-size: 13px; color: #98bcff; -unity-text-align: middle-center; }
.mini-title { font-size: 23px; -unity-font-style: bold; margin-bottom: 10px; }
.build-scroll { flex-grow: 1; min-height: 90px; }
.build-icons { flex-direction: row; flex-wrap: wrap; align-content: flex-start; }
.build-icon { width: 80px; height: 80px; min-height: 80px; padding: 9px; margin-right: 8px; margin-bottom: 8px; align-items: center; justify-content: center; }
.build-icon-level { position: absolute; right: 5px; bottom: 2px; font-size: 17px; -unity-font-style: bold; color: #d1e2ff; }
.build-detail { font-size: 20px; min-height: 100px; max-height: 130px; margin-top: 8px; color: #b4c4dc; }
.ability-button { height: 96px; min-height: 96px; flex-shrink: 0; margin-top: 8px; flex-direction: row; align-items: center; justify-content: center; background-color: #263750; border-color: #415c85; }
.ability-button .vector-icon { width: 60px; height: 60px; margin-right: 18px; }
.ability-ready { background-color: #295b4b; border-color: #72d8ac; }
.ability-body { align-items: flex-start; }
.ability-title { font-size: 25px; -unity-font-style: bold; }
.ability-hint { font-size: 19px; color: #b6cadf; }
.ability-button:disabled .ability-title, .ability-button:disabled .ability-hint { color: #8998af; }
.build-footer { min-height: 88px; flex-shrink: 0; padding-top: 15px; }
.inspection-title { font-size: 23px; -unity-font-style: bold; }
.inspection-area > .row { height: 52px; }
.inspection-area .icon-button { min-height: 48px; min-width: 60px; height: 48px; padding: 5px; }
.inspection-area .icon-button .vector-icon { width: 25px; height: 25px; }
.inspection-scroll { flex-grow: 1; }
.inspection-stats { font-size: 22px; color: #9cc1ff; margin-bottom: 12px; }
.inspection-effects { font-size: 20px; color: #c1cee1; margin-bottom: 12px; }
.fight-stats { margin: 5px 0; flex-shrink: 0; }
.fighter-stat { font-size: 17px; min-height: 23px; }
.danger-label { font-size: 18px; color: #ffbc84; min-height: 26px; margin: 2px 0; }
.speed-control { margin-bottom: 6px; }
/* Dialogs */
.overlay { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background-color: rgba(5,9,16,.78); align-items: center; justify-content: center; padding: 26px; }
.dialog { width: 100%; max-width: 650px; max-height: 92%; border-width: 1px; border-color: #526483; border-radius: 18px; background-color: #1d2738; padding: 26px; }
.dialog-title { font-size: 35px; -unity-font-style: bold; margin-bottom: 16px; }
.dialog-description { font-size: 23px; color: #b5c7df; margin-bottom: 14px; }
.dialog > .vector-icon { width: 58px; height: 58px; margin-bottom: 14px; }
.result-skill { flex-direction: row; align-items: center; padding: 7px; }
.result-skill .vector-icon { width: 42px; height: 42px; }

/* Remove native light field textures; these otherwise cover the graphite colour. */
.unity-base-field__input, .unity-base-popup-field__input { background-image: none; background-color: #2b3547; color: #eef2fa; }
.skill-content Label { -unity-text-align: upper-left; }
.unity-scroller--vertical { width: 9px; background-image: none; background-color: #182131; }
.unity-scroller--vertical .unity-scroller__low-button, .unity-scroller--vertical .unity-scroller__high-button { display: none; }
.unity-scroller--vertical .unity-base-slider__tracker { background-image: none; background-color: #202a3c; border-width: 0; }
.unity-scroller--vertical .unity-base-slider__dragger { background-image: none; background-color: #536583; border-radius: 5px; border-width: 0; }
.unity-base-dropdown__container-outer, .unity-base-dropdown__container-inner { background-color: #26344a; border-color: #536c91; }
.unity-base-dropdown__item { min-height: 72px; color: #eef2fa; }
.unity-base-dropdown__item-label { color: #eef2fa; font-size: 23px; }

.choice-field { min-height: 76px; flex-grow: 1; margin-bottom: 8px; }
.choice-field-label { font-size: 23px; color: #b9c6dc; min-width: 160px; }
.choice-field-value { min-height: 76px; flex-grow: 1; flex-direction: row; align-items: center; justify-content: flex-start; background-color: #2b3547; border-color: #45526b; }
.choice-field-text { flex-grow: 1; font-size: 23px; -unity-text-align: middle-left; }
.choice-field-arrow { width: 22px; height: 22px; margin-left: 8px; }
.selection-scroll { max-height: 660px; }
.selection-option { min-height: 84px; margin-bottom: 8px; flex-direction: row; align-items: center; justify-content: flex-start; }
.selection-label { font-size: 24px; -unity-text-align: middle-left; }
.selection-weapon { width: 45px; height: 40px; margin-right: 10px; }
.test-card .choice-field { margin-right: 8px; }
.test-card .choice-field-value { padding: 6px; }

.compact-hp { width: 185px; }
.compact-hp > .unity-base-field__label { min-width: 42px; width: 42px; }
.option-toggle { flex-direction: row; align-items: center; justify-content: space-between; padding: 12px; min-height: 76px; border-color: #3a485f; }
.toggle-label { font-size: 22px; flex-grow: 1; -unity-text-align: middle-left; }
.toggle-state { width: 68px; font-size: 20px; color: #a4b4cc; -unity-text-align: middle-right; }
.option-toggle.selected .toggle-state { color: #88e4b8; }

.number-field { justify-content: flex-start; }
.number-field-label { font-size: 23px; color: #b9c6dc; min-width: 44px; margin-right: 8px; }
.number-field-value { min-height: 76px; flex-grow: 1; color: #eef2fa; background-color: #2b3547; font-size: 25px; -unity-font-style: bold; }
.stake-input .number-field-label { min-width: 105px; }
.number-display { height: 72px; font-size: 36px; -unity-font-style: bold; background-color: #111b2c; padding: 12px; border-radius: 8px; -unity-text-align: middle-right; }
.number-range { margin-top: 7px; margin-bottom: 14px; }
.number-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.number-key { width: 32%; min-height: 96px; height: 96px; margin-bottom: 8px; font-size: 29px; }
.number-key-small { font-size: 20px; }
.number-actions { margin-top: 5px; }
.number-actions > Button { width: 49%; margin-top: 8px; min-height: 84px; }
.number-dialog { max-height: 100%; }
