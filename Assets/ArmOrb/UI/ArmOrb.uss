.app { flex-grow: 1; background-color: #f5f5f3; color: #111111; padding: 14px 22px 10px; }
Label { white-space: normal; }
Button { border-width: 1px; border-color: #111111; border-radius: 2px; margin: 0; padding: 6px 12px; color: #111111; background-color: white; font-size: 20px; min-height: 48px; }
Button:hover { background-color: #eeeeee; }
Button:active { background-color: #dddddd; }
Button:focus { border-color: #111111; }
.row { flex-direction: row; align-items: center; justify-content: space-between; }
.header { height: 54px; flex-shrink: 0; }
.logo { font-size: 32px; -unity-font-style: bold; }
.version { font-size: 16px; color: #888888; }
.setup-scroll { flex-grow: 1; }
.setup-content { padding-top: 22px; padding-bottom: 18px; }
.setup-options { margin-top: 22px; padding: 0 16px 12px; background-color: white; border-width: 1px; border-color: #d5d5d0; border-radius: 3px; }
.fighter-cards { align-items: stretch; flex-shrink: 0; }
.fighter-card { width: 48.5%; border-width: 2px; border-color: #111111; padding: 16px 12px; background-color: white; border-radius: 3px; }
.player { border-top-color: #ff626a; border-top-width: 5px; }
.enemy { border-top-color: #00c3cc; border-top-width: 5px; }
.side-name { font-size: 20px; -unity-font-style: bold; }
.coral { color: #ed4653; }
.teal { color: #009da7; }
.fighter-preview { height: 160px; margin-top: 8px; margin-bottom: 6px; align-items: center; justify-content: center; }
.preview-orb { width: 108px; height: 108px; margin-right: 54px; }
.weapon-preview { position: absolute; width: 135px; height: 105px; right: 0; top: 28px; }
.weapon-description { font-size: 17px; color: #666666; min-height: 48px; -unity-text-align: upper-center; margin-bottom: 12px; }
.weapon-name { font-size: 24px; -unity-font-style: bold; -unity-text-align: middle-center; margin-bottom: 5px; }
.weapons { flex-shrink: 0; flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.weapon-choice { width: 31%; height: 58px; margin-bottom: 7px; padding: 7px; border-color: #cccccc; background-color: #fafaf8; }
.weapon-choice-image { width: 100%; height: 100%; }
.player .weapon-choice.selected { border-color: #ed4653; border-width: 2px; background-color: #fff0f1; }
.enemy .weapon-choice.selected { border-color: #009da7; border-width: 2px; background-color: #e8fbfc; }
.health-input { margin: 17px 0 0; align-items: center; }
.health-input > .unity-base-field__label { font-size: 19px; min-width: 36px; width: 36px; }
.health-input > .unity-base-field__input { min-height: 47px; font-size: 24px; color: #111111; background-color: white; border-width: 1px; border-color: #999999; border-radius: 2px; padding: 4px 10px; }
.setting-label { font-size: 20px; margin-top: 23px; margin-bottom: 9px; }
.segments { flex-shrink: 0; }
.segment { width: 32%; height: 53px; font-size: 20px; }
.segment.selected { color: white; background-color: #111111; }
.segment.selected:hover { background-color: #333333; }
.gravity { margin-top: 25px; margin-bottom: 10px; min-height: 42px; font-size: 22px; }
.gravity .unity-toggle__checkmark { width: 28px; height: 28px; margin-right: 12px; }
.primary { height: 65px; color: white; background-color: #111111; -unity-font-style: bold; font-size: 24px; margin-top: 26px; flex-shrink: 0; }
.primary:hover { background-color: #333333; }
.primary:active { background-color: #555555; }
.secondary { height: 56px; margin-top: 12px; }
.footer { min-height: 48px; flex-shrink: 0; }
.text-button { border-width: 0; font-size: 17px; padding: 7px 0; color: #666666; min-height: 46px; }
.text-button:hover { color: #111111; background-color: white; }
.header-button { font-size: 18px; min-width: 132px; }
.timer { font-size: 26px; -unity-font-style: bold; }
.versus { margin-top: 13px; margin-bottom: 10px; flex-shrink: 0; }
.fighter-title { justify-content: center; width: 44%; }
.title-icon { width: 58px; height: 43px; margin-right: 10px; }
.match-weapon { font-size: 27px; -unity-font-style: bold; }
.vs { font-size: 16px; color: #777777; }
.health-row { flex-shrink: 0; }
.health-panel { width: 47%; }
.hp { font-size: 26px; -unity-font-style: bold; }
.small { font-size: 16px; }
.muted { color: #777777; }
.poison { min-height: 21px; font-size: 14px; color: #668430; }
.arena-holder { flex-grow: 1; min-height: 220px; align-items: center; justify-content: center; overflow: hidden; }
.arena { flex-shrink: 0; }
.stat-row { margin-top: 8px; margin-bottom: 16px; min-height: 40px; flex-shrink: 0; }
.stat-group { width: 49%; }
.reload-track { height: 4px; margin-top: 8px; background-color: #ddddda; }
.reload-fill { height: 4px; }
.player-fill { background-color: #ed4653; }
.enemy-fill { background-color: #009da7; }
.stat { font-size: 17px; -unity-font-style: bold; }
.stat.teal { -unity-text-align: middle-right; }
.overlay { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background-color: rgba(0,0,0,0.4); align-items: center; justify-content: center; padding: 30px; }
.dialog { width: 100%; max-width: 630px; border-width: 2px; border-color: #111111; background-color: white; padding: 28px; }
.dialog-title { font-size: 32px; -unity-font-style: bold; margin-bottom: 16px; }
.dialog-description { font-size: 21px; margin-bottom: 15px; }
.rule { font-size: 19px; margin-bottom: 18px; }
/* v0.5 */
.balance { font-size: 20px; -unity-font-style: bold; }
.mode-tabs { margin-top: 10px; margin-bottom: 8px; flex-shrink: 0; }
.mode-tab { width: 49%; height: 54px; font-size: 22px; }
.mode-tab.selected { color: white; background-color: #111111; }
.home-content { padding: 10px 0 18px; }
.section-name { font-size: 26px; margin-top: 18px; margin-bottom: 12px; -unity-font-style: bold; }
.conditions { border-width: 1px; border-color: #d5d5d0; padding: 15px; background-color: white; margin-bottom: 12px; }
.condition-title { font-size: 22px; margin-bottom: 7px; -unity-font-style: bold; }
.calculation { font-size: 21px; margin: 12px 0 6px; }
.error { color: #be343c; font-size: 19px; margin-bottom: 12px; }
.bet-choice { min-height: 76px; border-color: #d5d5d0; border-left-width: 6px; padding: 10px; margin-top: 8px; }
.bet-choice.selected { border-top-color: #111111; border-bottom-color: #111111; border-right-color: #111111; background-color: #eaeae4; }
.offer-icon { width: 46px; height: 42px; margin-right: 10px; flex-shrink: 0; }
.offer-name { flex-grow: 1; font-size: 21px; }
.offer-health { width: 90px; font-size: 18px; -unity-text-align: middle-right; }
.offer-odds { width: 105px; font-size: 23px; -unity-font-style: bold; -unity-text-align: middle-right; }
.stake-input { margin-top: 22px; min-height: 50px; font-size: 22px; }
.stake-input > .unity-base-field__label { min-width: 110px; }
.stake-input > .unity-base-field__input { background-color: white; border-width: 1px; border-color: #999999; font-size: 24px; padding: 8px; }
.payout { font-size: 19px; margin: 10px 0; }
.stake-button { width: 23%; }
.offer-actions > Button { width: 49%; font-size: 20px; }
.count-control { margin-bottom: 12px; }
.count-control .setting-label { flex-grow: 1; margin-top: 0; margin-bottom: 0; }
.count-button { min-width: 55px; margin-left: 12px; margin-right: 12px; }
.test-card { background-color: white; border-width: 1px; border-color: #d5d5d0; border-left-width: 5px; padding: 12px; margin-bottom: 10px; }
.participant-number { width: 50px; font-size: 23px; -unity-font-style: bold; }
.weapon-dropdown { flex-grow: 1; font-size: 22px; min-height: 48px; margin-right: 16px; }
.weapon-dropdown .unity-base-field__input { background-color: #f4f4f0; padding: 8px; }
.compact-hp { width: 170px; min-height: 48px; font-size: 21px; }
.compact-hp > .unity-base-field__label { min-width: 35px; width: 35px; }
.compact-hp > .unity-base-field__input { background-color: #f4f4f0; padding: 8px; }
.test-card > .small { margin-top: 6px; }
.wide-field { min-height: 48px; font-size: 21px; margin-bottom: 10px; }
.wide-field .unity-base-field__input { padding: 10px; background-color: #f4f4f0; }
.option-toggle { min-height: 42px; font-size: 20px; margin-top: 10px; }
.option-toggle .unity-toggle__checkmark { width: 26px; height: 26px; margin-right: 12px; }
.fight-participants { flex-direction: row; flex-wrap: wrap; justify-content: space-between; flex-shrink: 0; margin-top: 8px; }
.fight-participant { width: 49%; padding: 6px 8px; border-left-width: 4px; margin-bottom: 5px; background-color: white; }
.fighter-label { font-size: 18px; }
.fight-hp { font-size: 19px; -unity-font-style: bold; }
.fight-participant .reload-track { margin-top: 4px; height: 3px; }
.danger-label { min-height: 25px; font-size: 16px; color: #b55226; margin: 4px 0; }
.fight-stats { flex-shrink: 0; margin: 8px 0 12px; }
.fighter-stat { font-size: 15px; min-height: 23px; }
/* v0.6 */
.mode-tab { width: 32%; font-size: 20px; }
.mini-description { margin-top: 14px; }
.bot-preview-line { font-size: 20px; margin-top: 6px; }
.bot-fight .header { height: 48px; }
.bot-fight .fight-participants { margin-top: 2px; }
.bot-fight .fight-participant { padding-top: 3px; padding-bottom: 3px; }
.bot-fight .fighter-label { font-size: 17px; }
.bot-fight .fight-hp { font-size: 18px; }
.bot-arena-holder { flex-grow: 0; flex-shrink: 1; min-height: 180px; }
.essence-row { min-height: 44px; flex-shrink: 0; border-bottom-width: 1px; border-bottom-color: #d5d5d0; }
.essence { font-size: 24px; -unity-font-style: bold; color: #7350b1; }
.mini-panel { flex-grow: 1; min-height: 220px; padding: 8px 12px; background-color: white; border-width: 1px; border-color: #d5d5d0; margin-top: 8px; }
.mini-title { font-size: 24px; -unity-font-style: bold; }
.mini-canvas { flex-grow: 1; min-height: 120px; margin-top: 4px; }
.mini-feedback { font-size: 18px; min-height: 26px; color: #7350b1; -unity-text-align: middle-center; }
.shop-item { border-width: 1px; border-color: #d5d5d0; padding: 12px; margin-bottom: 10px; }
.shop-item .wide-field { margin-top: 8px; font-size: 18px; }
.shop-buy { margin-top: 10px; min-height: 48px; }
